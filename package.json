{
	"name": "scoredle",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"register": "esbuild src/register.ts --bundle --platform=node --format=esm --loader:.sql=text --external:dotenv | node --input-type=module",
		"ngrok": "ngrok http 8787",
		"deploy": "npm run register && wrangler deploy",
		"dev": "npm run register && wrangler dev",
		"cf-typegen": "wrangler types"
	},
	"devDependencies": {
		"@types/node": "^26.6.11",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"wrangler": "^4"
	},
	"dependencies": {
		"discord-api-types": "^0.38.60",
		"discord-interactions": "^4.4.0",
		"itty-router": "^5.0.24"
	}
}
